@@ -1428,6 +1428,13 @@ class DistAttnRuntime:
                     sink_layout="sh",
                     deterministic=self.deterministic,
                 )
+                if self.bwd_hp_reduce:
+                    # MAGI_ATTENTION_BACKWARD_HIGH_PRECISION_REDUCE=1 with the FA4 backend: FA4 only emits fp16 / bf16,
+                    # so its per-call partial dq / dk / dv are widened to fp32 here; the buffers, the group-reduce
+                    # communication and the accumulation then run in fp32 as Magi's high-precision reduce does for FFA
+                    partial_dq, partial_dk, partial_dv = (
+                        x.to(self.hp_dtype) for x in (partial_dq, partial_dk, partial_dv)
+                    )
                 partial_dkv = self._maybe_concat(
                     partial_dk, partial_dv, need_concat=self.concat_dkv
                 )
@@ -2239,7 +2246,7 @@ class DistAttnRuntime:
                     # dkv always in high-precision if using native grpcoll
                     # unless using fa4 backend which only supports fp16/bf16 for now
                     need_hp_dtype=(
-                        self.kernel_backend != MagiAttentionKernelBackend.FA4
+                        (self.kernel_backend != MagiAttentionKernelBackend.FA4 or self.bwd_hp_reduce)
                     )
                     and (self.use_native_grpcoll or self.bwd_hp_reduce),
                 ),
