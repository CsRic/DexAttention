+# MagiAttention (calc_meta._resolve_tile_sizes) imports this to size its block-sparse metadata on sm8x (sm80/sm86), where its
+# fa4 route runs the hopper/ cutlass C++ kernels of this repository. Python
+# copy of hopper/tile_size.h (tile_size_fwd_sm8x / tile_size_bwd_sm8x, 16-bit elements, the call Magi makes: no
+# causal / local / softcap / varlen / split / paged KV). Returns (kBlockM, kBlockN).
+def get_tile_sizes_by_backend(pass_type: str, headdim: int = 128, is_arbitrary: bool = True):
+    import torch
+    major, minor = torch.cuda.get_device_capability()
+    if major != 8:
+        raise NotImplementedError(f"get_tile_sizes_by_backend: only the sm8x tables are copied (got sm{major}{minor})")
+    sm86_or_89 = minor in (6, 9)
+    arb = bool(is_arbitrary)
+    if pass_type in ("forward", "fwd"):
+        if headdim <= 64:
+            return 128, 96 if arb else 112
+        if headdim <= 96:
+            return 128, 48 if arb else 64
+        if headdim <= 128:
+            return 128, (96 if arb else 128) if sm86_or_89 else (48 if arb else 64)
+        if headdim <= 192:
+            return 128, 64 if arb else 96
+        return 128, (48 if arb else 64) if sm86_or_89 else (64 if arb else 96)
+    if pass_type in ("backward", "bwd"):
+        if sm86_or_89:
+            return (64, 128) if headdim <= 96 else (64, 96) if headdim <= 128 else (64, 64) if headdim <= 192 else (32, 64)
+        return (128, 128) if headdim <= 64 else (64, 128) if headdim <= 128 else (64, 80) if headdim <= 192 else (64, 64)
+    raise ValueError(f"pass_type {pass_type!r}")
