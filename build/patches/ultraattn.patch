new file mode 100644
index 0000000..bd7682e
--- /dev/null
+++ b/search_algo/dcp_adapter.py
@@ -0,0 +1,90 @@
+"""Bring an externally computed block assignment into UltraAttn's own planning pipeline.
+
+The block problem and the assignment containers are those of the Dex release (baselines/ua/deploy.py; the release
+root must be on PYTHONPATH). Mapping (with UA_FAITHFUL=1, partial blocks are priced by live / nominal work
+through dependent_graph.LIVE_SCALE):
+  BlockProblem                         UltraAttn
+  ---------------------------------------------------------------
+  weight 0    (dead)                   Block_Type.EMPTY    (vol 0)
+  weight exactly 0.5                   Block_Type.CAUSAL   (vol 0.5)
+  any other weight                     Block_Type.FULL     (vol 1)
+  asg.owner[b]  block -> device        cmap[b] / S_map[0, b]
+  asg.dev[q, k] tile  -> device        schedule_table[0, 0, q, k]
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+
+import numpy as np
+
+sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), os.pardir)))
+
+from search_algo.utils import Block_Type                      # noqa: E402
+from search_algo.bsa_config import BSA_Repr, BSA_Config       # noqa: E402
+from search_algo.global_vars import TASK_STATUS               # noqa: E402
+
+
+def problem_to_block_table(prob) -> np.ndarray:
+    """BlockProblem weights -> UltraAttn Block_Type table (ParD x ParD)."""
+    w = prob.weights()
+    n = prob.n_blocks
+    bt = np.empty((n, n), dtype=Block_Type)
+    for i in range(n):
+        for j in range(n):
+            x = float(w[i, j])
+            bt[i, j] = (Block_Type.EMPTY if x == 0
+                        else Block_Type.CAUSAL if abs(x - 0.5) < 1e-9
+                        else Block_Type.FULL)
+    return bt
+
+
+def build_bsa_config(prob, owner: np.ndarray, CP_intra: int, CP_inter: int = 1) -> BSA_Config:
+    """Wrap the problem's mask as a BSA_Config. cmap stays None, as in UltraAttn's own pipeline (task1_bsa.py);
+    ownership rides in S_map / schedule_table, which is what Dist_Attn_Schedule reads."""
+    bt = problem_to_block_table(prob)
+    repr_ = BSA_Repr(bt, cmap=None)
+    return BSA_Config(pat_bsa_repr={"bsa_repr": repr_, "CP": (CP_intra, CP_inter)})
+
+
+def assignment_to_schedule_table(prob, dev: np.ndarray, split_Nh: int = 1,
+                                 split_bs: int = 1) -> np.ndarray:
+    """tile -> device map as UltraAttn's (bs, Nh, Sq, Skv) schedule_table; masked tiles carry TASK_STATUS.EMPTY."""
+    w = prob.weights()
+    n = prob.n_blocks
+    table = np.empty((split_bs, split_Nh, n, n), dtype=np.int32)
+    table.fill(TASK_STATUS.EMPTY.value)
+    for i in range(n):
+        for j in range(n):
+            if float(w[i, j]) > 0:
+                table[:, :, i, j] = int(dev[i, j])
+    return table
+
+
+def plan_from_problem(problem_json: str, strategy: str, CP_intra: int, CP_inter: int = 1,
+                      assignment_file: str = None):
+    """Load a problem and its assignment (a file {dev, owner}, or a fresh run of `strategy`); return everything
+    UltraAttn needs: (prob, asg, bsa_config, schedule_table, S_map)."""
+    from baselines.ua.deploy import STRATEGIES, Assignment, BlockProblem, Topo
+
+    prob = BlockProblem.from_json(open(problem_json).read())
+    topo = Topo(n_nodes=CP_inter, gpus_per_node=CP_intra)
+    # Per-block byte costs default to MHA (Q 1 : K+V 2 : partial O 1); PG_BYTES="q,kv,o" sets the real sizes.
+    if os.environ.get("PG_BYTES"):
+        topo.q_bytes, topo.kv_bytes, topo.o_bytes = (float(x) for x in os.environ["PG_BYTES"].split(","))
+        print(f"[adapter] block byte costs q={topo.q_bytes} kv={topo.kv_bytes} o={topo.o_bytes}", flush=True)
+    if assignment_file:
+        blob = json.load(open(assignment_file))
+        asg = Assignment(strategy, np.asarray(blob["dev"], dtype=np.int64), np.asarray(blob["owner"], dtype=np.int64))
+        print(f"[adapter] explicit assignment {os.path.basename(assignment_file)}", flush=True)
+    else:
+        import time as _time
+        _t0 = _time.perf_counter()
+        asg = STRATEGIES[strategy](prob, topo)
+        print(f"[phase] n_blocks={prob.n_blocks} stage=deployment strategy={strategy} "
+              f"world={CP_intra * CP_inter} seconds={_time.perf_counter() - _t0:.4f}", flush=True)
+    bsa_config = build_bsa_config(prob, asg.owner, CP_intra, CP_inter)
+    schedule_table = assignment_to_schedule_table(prob, asg.dev)
+    S_map = np.asarray(asg.owner, dtype=np.int32).reshape(1, prob.n_blocks)
+    return prob, asg, bsa_config, schedule_table, S_map
