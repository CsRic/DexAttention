+# ---- per-kernel tracing (off unless UA_TRACE=1) ----------------------------
+# Each kernel is bracketed by a pair of CUDA events on its own stream, so what
+# comes out is when the kernel actually ran on the GPU, not when the host
+# enqueued it. The list is cleared at the top of every forward pass, so after
+# the benchmark it holds exactly the last iteration.
+UA_TRACE = bool(int(os.environ.get("UA_TRACE", "0")))
+_TRACE = []
+_EPOCH = [0]
+
+
+def trace_new_epoch():
+    """Called once per forward pass. Records carry the epoch they were made in,
+    so the dump can keep only the last iteration -- a plain reset would not work
+    at the inter level, where one inter compute kernel runs a whole intra plan
+    and would clear the records of the kernels around it."""
+    _EPOCH[0] += 1
+
+
+def trace_dump(path, rank, extra=None):
+    """Resolve the recorded events into ms relative to the first kernel start."""
+    import json
+    torch.cuda.synchronize()
+    if not _TRACE:
+        return
+    last = max(e for _, _, _, _, e in _TRACE)
+    keep = [t for t in _TRACE if t[4] == last]
+    if not keep:
+        return
+    base = keep[0][2]
+    recs = []
+    for key, kind, ev0, ev1, _e in keep:
+        try:
+            start = base.elapsed_time(ev0)
+            dur = ev0.elapsed_time(ev1)
+        except Exception:
+            continue
+        r = dict(kind="comm" if kind == "inter_comm" else kind,
+                 level="inter" if kind == "inter_comm" else "intra",
+                 start=start, dur=dur)
+        if kind == "comp":
+            r["rows"] = [int(x) for x in key[2]] if isinstance(key[2], tuple) else [int(key[2])]
+            r["cols"] = [int(x) for x in key[3]] if isinstance(key[3], tuple) else [int(key[3])]
+            r["fused"] = len(r["rows"]) * len(r["cols"]) > 1
+        else:
+            r.update(block=int(key[2]), src=int(key[3]), dst=int(key[4]),
+                     io=key[5], rc=key[6],
+                     role="send" if int(key[3]) == rank else "recv")
+        recs.append(r)
+    out = dict(rank=rank, kernels=recs)
+    if extra:
+        out.update(extra)
+    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
+    json.dump(out, open(path, "w"))
