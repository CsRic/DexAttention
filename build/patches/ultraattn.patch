index 0000000..d4ef1f0
--- /dev/null
+++ b/search_algo/dump_plan_structure.py
@@ -0,0 +1,158 @@
+"""Dump a fused Execution_Plan's structure as JSON (the plan interchange format of the Dex release).
+
+It records who owns which block, which tiles
+each GPU computes, which of those tiles got fused into which rectangle, every
+transfer with its source and destination, and each GPU's kernels in the order
+the schedule sets.
+
+Plan construction is CPU work, so this runs without measuring and at any CP --
+including CP=8 on a 4-GPU box.
+
+    torchrun --nproc_per_node 1 search_algo/dump_plan_structure.py \
+        --problem <problem.json> --strategy dcp --cp 8 --out plan.json
+"""
+from __future__ import annotations
+
+import argparse, json, os, sys
+import numpy as np
+import torch
+
+sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), os.pardir)))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--problem", required=True)
+    ap.add_argument("--strategy", default="dcp")
+    ap.add_argument("--cp", type=int, default=8)
+    ap.add_argument("--nodes", type=int, default=1,
+                    help="how many NODES the CP spans. The planner's cost model "
+                         "charges an inter-node byte 12x an intra-node one, so a "
+                         "16-GPU plan searched as 1x16 is a DIFFERENT plan from "
+                         "one searched as 4x4 -- pass the real shape.")
+    ap.add_argument("--block-tokens", type=int, default=1024)
+    ap.add_argument("--heads", type=int, default=8)
+    ap.add_argument("--kv-heads", type=int, default=0, help="GQA K/V heads (0 = MHA); needs UA_FAITHFUL=1")
+    ap.add_argument("--transform-mode", default="greedy")
+    ap.add_argument("--sched-rungs", default="flexflow", choices=["flexflow", "all"])
+    ap.add_argument("--rung", default="w_kernel_tile",
+                    choices=["w_kernel_tile", "w/o_kernel_tile"])
+    ap.add_argument("--assignment", default=None)
+    ap.add_argument("--fob", type=int, default=0, help="1: UltraAttn's BACKWARD dependent graph / execution plan (rows send Q, dO, LSE, D; cols K, V; outputs dQ to rows, dK, dV to cols)")
+    ap.add_argument("--out", default=None)
+    ap.add_argument("--batch", default=None,
+                    help="json list of {problem, assignment, out, block_tokens, heads, kv_heads, "
+                         "fusion_budget_s}: one process (distribution + profile DB set up once) builds every plan; "
+                         "per-task seconds -> <batch>.times.jsonl")
+    args = ap.parse_args()
+
+    import dcp_in_ultraattn as D
+    from search_algo.dcp_adapter import plan_from_problem
+
+    import time as _time
+    t_init = _time.perf_counter()
+    ncclcomm_global, gloo_group = D.initialize_distribution()
+    prof_db = D.initialize_prof_db(gloo_group)
+    D.install_profile_interpolation()
+    t_init = _time.perf_counter() - t_init
+    if args.batch is None:
+        assert args.out, "--out (or --batch)"
+        return run_one(args, D, plan_from_problem, prof_db)
+    tasks = json.load(open(args.batch))
+    with open(args.batch + ".times.jsonl", "w") as tf:
+        tf.write(json.dumps(dict(init_s=round(t_init, 3), n=len(tasks))) + "\n")
+        for t in tasks:
+            a = argparse.Namespace(**vars(args))
+            a.problem, a.assignment, a.out = t["problem"], t["assignment"], t["out"]
+            a.block_tokens, a.heads, a.kv_heads = t["block_tokens"], t["heads"], t.get("kv_heads", 0)
+            os.environ["UA_FUSION_BUDGET_S"] = str(t["fusion_budget_s"])
+            t0 = _time.perf_counter(); ok = True
+            try:
+                run_one(a, D, plan_from_problem, prof_db)
+            except Exception as e:   # noqa: BLE001  (one failed problem must not stop the batch)
+                ok = False; print(f"[batch] {t['out']}: {type(e).__name__}: {e}", flush=True)
+            tf.write(json.dumps(dict(out=t["out"], seconds=round(_time.perf_counter() - t0, 3), ok=ok)) + "\n"); tf.flush()
+
+
+def run_one(args, D, plan_from_problem, prof_db):
+    if args.cp % args.nodes:
+        raise SystemExit(f"--cp {args.cp} is not divisible by --nodes {args.nodes}")
+    cp_intra, cp_inter = args.cp // args.nodes, args.nodes
+    print(f"[topo] CP={args.cp} as {cp_inter} node(s) x {cp_intra} GPU(s)", flush=True)
+    prob, asg, bsa_config, table, S_map = plan_from_problem(
+        args.problem, args.strategy, cp_intra, cp_inter,
+        assignment_file=args.assignment)
+    da_config, schedule, plans, failed = D.build_plans(
+        prob, bsa_config, table, S_map, prof_db, args)
+    if torch.distributed.get_rank() != 0:
+        return
+    wanted = [k for k in plans if k[1] == args.rung]
+    if not wanted:
+        # If UltraAttn's fused-plan builder lacks profile-DB entries for this
+        # topology, no fused plan exists for the rung. The assignment is the
+        # only thing a non-UltraAttn executor consumes, so it is still dumped,
+        # with the missing fusion stage recorded (assignment_only,
+        # fusion_error).
+        print(f"rung {args.rung} unavailable: {failed}", flush=True)
+        N = prob.n_blocks
+        tbl = np.asarray(table)
+        while tbl.ndim > 2:
+            tbl = tbl[0]
+        json.dump(dict(
+            family=os.path.basename(args.problem).split("_s0")[0],
+            strategy=args.strategy, cp=args.cp, n_blocks=N,
+            nodes=args.nodes, gpus_per_node=cp_intra,
+            block_tokens=args.block_tokens, rung=args.rung,
+            assignment_only=True, fusion_error=str(failed),
+            end_time=None,
+            owner=[int(S_map[0, b]) for b in range(N)],
+            schedule_table=[[int(tbl[r, c]) for c in range(N)] for r in range(N)],
+            live=[], gpu_kernels=[]), open(args.out, "w"))
+        print(f"-> {args.out}  CP={args.cp} N={N} ASSIGNMENT-ONLY "
+              f"(no fused plan)", flush=True)
+        return
+    plan = plans[wanted[0]]
+
+    N = prob.n_blocks
+    w = prob.weights()
+    st = np.asarray(schedule.schedule_table)[0, 0]     # (Sq, Skv) -> gpu, -1 masked
+
+    gpus = []
+    for g in range(args.cp):
+        kernels = []
+        for k in plan.gpu_kernel_lists[g]:
+            key = k.key
+            rec = dict(start=float(k._start_time), time=float(k.time[0]))
+            if k.type == "comp":
+                r_id, c_id = key[2], key[3]
+                rows = [int(x) for x in r_id] if isinstance(r_id, tuple) else [int(r_id)]
+                cols = [int(x) for x in c_id] if isinstance(c_id, tuple) else [int(c_id)]
+                rec.update(kind="comp", rows=rows, cols=cols,
+                           fused=len(rows) * len(cols) > 1)
+            else:
+                _, _, idx, src, dst, io, rc = key
+                rec.update(kind="comm", block=int(idx), src=int(src), dst=int(dst),
+                           io=io, rc=rc, role="send" if int(src) == g else "recv")
+            kernels.append(rec)
+        gpus.append(kernels)
+
+    out = dict(
+        family=os.path.basename(args.problem).split("_s0")[0],
+        strategy=args.strategy, cp=args.cp, n_blocks=N,
+        nodes=args.nodes, gpus_per_node=cp_intra,
+        block_tokens=args.block_tokens, rung=args.rung, fob=int(getattr(args, "fob", 0)),
+        end_time=float(plan.end_time) if hasattr(plan, "end_time") else None,
+        owner=[int(S_map[0, b]) for b in range(N)],
+        schedule_table=[[int(st[r, c]) for c in range(N)] for r in range(N)],
+        live=[[bool(w[r, c] > 0) for c in range(N)] for r in range(N)],
+        gpu_kernels=gpus,
+    )
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    json.dump(out, open(args.out, "w"))
+    n_f = sum(1 for gk in gpus for k in gk if k.get("fused"))
+    n_c = sum(1 for gk in gpus for k in gk if k["kind"] == "comp")
+    print(f"-> {args.out}  CP={args.cp} N={N} comp={n_c} fused={n_f}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/search_algo/execute_plan.py b/search_algo/execute_plan.py
index f6b9bf6..2c9f0a8 100644
--- a/search_algo/execute_plan.py
