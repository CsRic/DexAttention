+"""Stand-in for UltraAttn's `third_party/kernel_profiler` submodule, which is not public.
+
+Emits the same JSON the cost model reads:
+
+    {"flash_attn": [ [[min(Sq,Skv), bs, Nh, D, "Sq/Skv", causal], [fwd_us, bwd_us]], ... ]}
+
+The key layout is `Machine_Config.get_comp_map_key` (search_algo/search_engine.py:196)
+and the values are consumed by `convert_profile_data_to_map`, which divides by 1e6.
+
+    python tools/profile_kernel.py --out database/m_configs/time_<cluster>_m2.json
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import time
+
+import torch
+from flash_attn import flash_attn_func
+
+from math import gcd
+
+# The tiler can ask for any Q/KV length ratio a/b with max(a, b) <= 8 (the limit
+# asserted in search_engine.get_comp_map_key).  Their shipped profile data only
+# covers seven of them, which is why irregular patterns hit "key not found".
+ALL_RATIOS = [f"{a}/{b}" for a in range(1, 9) for b in range(1, 9) if gcd(a, b) == 1]
+DEFAULT_RATIOS = ["1/1", "1/2", "2/1", "1/3", "3/1", "1/4", "4/1"]
+
+
+def bench(fn, iters, warmup=10):
+    for _ in range(warmup):
+        fn()
+    torch.cuda.synchronize()
+    t0 = time.perf_counter()
+    for _ in range(iters):
+        fn()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - t0) / iters * 1e6            # microseconds
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--seqs", type=int, nargs="*",
+                    default=[256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536])
+    ap.add_argument("--bs", type=int, nargs="*", default=[1])
+    # NOTE: the default head counts skip nheads=1, the setting UltraAttn's own
+    # experiments use to emulate pairing with Ulysses: with batch 1 and one head
+    # flash-attn's forward timing does not follow the head scaling of nheads
+    # 2..32. Pass --nh 1 to profile it anyway.
+    ap.add_argument("--nh", type=int, nargs="*", default=[2, 4, 8, 32])
+    ap.add_argument("--dim", type=int, default=128)
+    ap.add_argument("--max-elems", type=float, default=5e10,
+                    help="skip a shape when bs*Sq*Skv*Nh exceeds this (time/memory guard)")
+    ap.add_argument("--dtype", default="bf16")
+    ap.add_argument("--nkv", type=int, default=0,
+                    help="GQA: K/V heads (0 = MHA, K/V have --nh heads). The profile key keeps Nh = query heads, so a "
+                         "per-model database (one GQA ratio) is consumed unchanged by the cost model.")
+    ap.add_argument("--warmup", type=int, default=10)
+    ap.add_argument("--ratios", default="default", choices=["default", "all"])
+    ap.add_argument("--merge", default=None,
+                    help="existing json to extend rather than replace")
+    args = ap.parse_args()
+
+    dt = dict(bf16=torch.bfloat16, fp16=torch.float16)[args.dtype]
+    ratios = ALL_RATIOS if args.ratios == 'all' else DEFAULT_RATIOS
+    out, t_start = [], time.perf_counter()
+    have = set()
+    if args.merge:
+        out = json.load(open(args.merge))['flash_attn']
+        have = {tuple(e[0]) for e in out}
+        print(f'merging into {len(out)} existing shapes', flush=True)
+    for S in args.seqs:
+        for bs in args.bs:
+            for nh in args.nh:
+                for ratio in ratios:
+                    a, b = (int(x) for x in ratio.split("/"))
+                    sq, skv = S * a, S * b
+                    if bs * sq * skv * nh > args.max_elems:
+                        continue
+                    for causal in (False, True):
+                        if (S, bs, nh, args.dim, ratio, causal) in have:
+                            continue
+                        if causal and sq != skv:
+                            continue          # causal is only profiled on square shapes
+                        try:
+                            q = torch.randn(bs, sq, nh, args.dim, device="cuda",
+                                            dtype=dt, requires_grad=True)
+                            k = torch.randn(bs, skv, args.nkv or nh, args.dim, device="cuda",
+                                            dtype=dt, requires_grad=True)
+                            v = torch.randn_like(k, requires_grad=True)
+                            work = bs * sq * skv * nh
+                            it = int(max(3, min(20, 2e10 / max(work, 1))))
+                            fwd = bench(lambda: flash_attn_func(q, k, v, causal=causal), it, args.warmup)
+                            o = flash_attn_func(q, k, v, causal=causal)
+                            g = torch.randn_like(o)
+                            bwd = bench(lambda: torch.autograd.grad(
+                                o, (q, k, v), g, retain_graph=True), it, args.warmup)
+                            out.append([[S, bs, nh, args.dim, ratio, causal],
+                                        [round(fwd, 3), round(bwd, 3)]])
+                            print(f"S={S:7d} bs={bs:3d} Nh={nh} {ratio:4s} causal={causal:d}"
+                                  f"  fwd {fwd:9.1f}us  bwd {bwd:9.1f}us", flush=True)
+                        except torch.OutOfMemoryError:
+                            print(f"S={S} bs={bs} {ratio} causal={causal}: OOM, skipped",
+                                  flush=True)
+                        finally:
+                            del q, k, v
+                            torch.cuda.empty_cache()
+    json.dump({"flash_attn": out}, open(args.out, "w"))
+    print(f"\n{len(out)} shapes in {time.perf_counter() - t_start:.0f}s -> {args.out}")
+
+
+if __name__ == "__main__":
+    main()
