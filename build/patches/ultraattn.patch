+            "FFFF......FFFFC.", "FFFF......FFFFFC",
+        ]
+        rows_8 = ["C.......", "FC......", "FFC.....", "FFFC....",
+                  "FF..C...", "FF..FC..", "FF......".replace("....", "..C.")[:8],
