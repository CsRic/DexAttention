index 0000000..a9022be
--- /dev/null
+++ b/search_algo/dcp_in_ultraattn.py
@@ -0,0 +1,518 @@
+"""Build UltraAttn execution plans from a given block assignment.
+
+Mirrors `generate_intra_bsa_execution_plans` in task1_bsa.py, but replaces
+UltraAttn's own `cc_optimal_schedule` with a schedule table produced by an
+external assignment.  Everything downstream -- Dependent_Graph, the kernel
+tiling in Graph_Transformation_Engine, the scheduling ILP -- is UltraAttn's own
+code, so the planners are compared under identical execution machinery.
+
+Note the kernel-tile gate: `bsa_is_dense` restricts kernel tiling on the INTER
+node path only (task1_bsa.py:534).  The intra-node path has no such gate, so
+sparse patterns do get tiled here.
+
+    torchrun --nproc_per_node 4 search_algo/dcp_in_ultraattn.py \
+        --problem <problem.json> \
+        --strategy ultraattn --cp 4 --block-tokens 512 --heads 8
+"""
+from __future__ import annotations
+
+import argparse
+import time
+import os
+import sys
+
+import numpy as np
+import torch
+
+sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), os.pardir)))
+
+from search_algo.initialize import initialize_distribution, initialize_prof_db
+from search_algo.search_engine import (Dist_Attn_Config, Dist_Attn_Schedule,
+                                       Evaluation_Configs)
+from search_algo.dependent_graph import Dependent_Graph
+from search_algo.execute_plan import Execution_Plan
+from search_algo.graph_transformation_engine import Graph_Transformation_Engine
+from search_algo.global_vars import set_global_var
+from search_algo.dcp_adapter import plan_from_problem
+from search_algo.benchmark import benchmark_orchestrate_bsa
+from search_algo.utils import parse_args as ua_parse_args
+from orchestrated_attn.orchestrated_attn_impl import orchestrated_attn_func
+from search_algo.global_vars import get_global_var
+from functools import partial
+
+
+# The five ablation keys UltraAttn's own profiler expects for one da_config.
+ABLATIONS = [("w/o_gpu_tile", "w/o_kernel_tile", "Flexflow")] + [
+    (None, kt, ks) for ks in ("Flexflow", "ILP")
+    for kt in ("w/o_kernel_tile", "w_kernel_tile")]
+
+
+def ablation_key(da_config, fob, gpu_tile, kernel_tile, kernel_sched):
+    pre = (f"fob={fob}_CP={da_config.bsa_config.CP}"
+           f"_shape_config={{{da_config.get_shape_config_str()}}}"
+           f"_bsa_config={{{da_config.bsa_config}}}")
+    suf = (f"_ablation=({gpu_tile},{kernel_tile},{kernel_sched})" if gpu_tile
+           else f"_ablation=({kernel_tile},{kernel_sched})")
+    return pre + suf
+
+
+INTERPOLATED = {}
+
+
+FAITHFUL = os.environ.get("UA_FAITHFUL") == "1"
+
+
+def install_profile_interpolation():
+    """Let the cost model price a fused shape that was never profiled.
+
+    Their kernel profile is measured on S = powers of two (256..65536) for every
+    Q/KV block ratio p/q, p,q in 1..8.  Fusing three 512-token blocks asks for
+    S=1536, which is off that grid, and the lookup is a hard dict access behind
+    an assert -- so plan construction dies rather than the plan being costed.
+
+    Two kinds of miss are priced here.
+
+    1. **Off-grid S, profiled ratio.**  Interpolate log-log in S among the
+       entries matching on (bs, Nh, D, ratio, causal); at a given ratio attention
+       time grows like S^2, so log-log is close to linear and 1536 sits between
+       two measured points.
+
+    2. **Unprofiled ratio.**  A greedy fusion on an irregular mask readily
+       produces a rectangle like 5/9, and p or q > 8 is outside everything they
+       measured, so there is no same-ratio series to interpolate along.  Their
+       code asserts, which kills the whole `w_kernel_tile` rung rather than
+       rejecting the one candidate.  Price it instead from FLOPs: at a given
+       (bs, Nh, D, causal) attention time is proportional to Sq*Skv, so scale
+       the nearest profiled entry by the FLOP ratio.  Sq and Skv are recoverable
+       from the key, which carries min(Sq, Skv) and the reduced ratio p/q.
+
+    Every miss is recorded and reported: these are ESTIMATED costs, and they
+    steer which plan the search picks.  They do not touch measured runtimes --
+    what a rung reports as `MEASURED` is always a real timed run.
+    """
+    from search_algo.search_engine import Comp_Profile_Map, Machine_Config
+    orig = Comp_Profile_Map.get_comp_time_from_map_key
+
+    def _sq_skv(map_key):
+        """(Sq, Skv) from a key (min(Sq,Skv), bs, Nh, D, 'p/q', causal)."""
+        lo, ratio = map_key[0], map_key[4]
+        if isinstance(ratio, str) and "/" in ratio:
+            p, q = (int(t) for t in ratio.split("/"))
+        else:
+            r = float(ratio)
+            p, q = (r, 1.0) if r >= 1 else (1.0, 1.0 / r)
+        return (lo * p / q, lo) if p >= q else (lo, lo * q / p)
+
+    # ---- robust FLOP-linear rate from TRUSTED entries -----------------------
+    # Attention compute is linear in Sq*Skv (a fused r*c rectangle is r*c tiles),
+    # and the per-FLOP cost is taken as flat across ratio and S in the
+    # large-block regime. Two kinds of profile entry are not trusted for that
+    # rate, since they would misprice the large fused rectangles a sink-heavy
+    # mask needs:
+    #   * augmented fused-ratio entries (e.g. 7/2), and
+    #   * small-S entries (min(Sq,Skv) < S_TRUST); the smallest ones
+    #     (S <= 2048) are dominated by kernel launch cost.
+    # Both are left out of the rate fit.
+    # Calibrate one per-FLOP rate per (bs,Nh,D,causal) from the TRUSTED base grid
+    # (ratio p/1 or 1/q, min(Sq,Skv)>=S_TRUST) and price every comp kernel off it.
+    # Keep an exact profiled value only when it AGREES with that rate (<=DEVx);
+    # otherwise the linear estimate is used.
+    S_TRUST = 8192
+    DEV = 1.5
+    _rate = {}
+
+    def _robust_rate(pm, sig):
+        if sig in _rate:
+            return _rate[sig]
+        fs, bs_ = [], []
+        for k, v in pm.items():
+            if (k[1], k[2], k[3], k[5]) != sig:
+                continue
+            ratio = k[4]
+            if isinstance(ratio, str) and "/" in ratio:
+                p, q = (int(t) for t in ratio.split("/"))
+                if p != 1 and q != 1:            # trust only the base grid p/1, 1/q
+                    continue
+            a, b = _sq_skv(k)
+            if min(a, b) < S_TRUST or a * b <= 0:
+                continue
+            va = np.asarray(v, dtype=float)
+            fs.append(va[0] / (a * b)); bs_.append(va[1] / (a * b))
+        r = (float(np.median(fs)), float(np.median(bs_))) if fs else None
+        _rate[sig] = r
+        return r
+
+    def _linear(pm, map_key):
+        r = _robust_rate(pm, (map_key[1], map_key[2], map_key[3], map_key[5]))
+        if r is None:
+            return None
+        sq, skv = _sq_skv(map_key)
+        return np.array([r[0] * sq * skv, r[1] * sq * skv])
+
+    def _nearest_entry(self, map_key, pm):
+        same = sorted((k[0], np.asarray(v, dtype=float))
+                      for k, v in pm.items() if tuple(k[1:]) == tuple(map_key[1:]))
+        if len(same) < 2:
+            try:
+                sq, skv = _sq_skv(map_key); want = sq * skv
+                cands = []
+                for k, v in pm.items():
+                    if (k[1], k[2], k[3], k[5]) != (map_key[1], map_key[2],
+                                                    map_key[3], map_key[5]):
+                        continue
+                    a, b = _sq_skv(k)
+                    if a * b > 0:
+                        cands.append((abs(np.log(a * b / want)), a * b,
+                                      np.asarray(v, dtype=float)))
+                if not cands:
+                    return orig(self, map_key)
+                _, flops, val = min(cands, key=lambda t: t[0])
+                out = val * (want / flops)
+                INTERPOLATED[tuple(map_key)] = out.tolist()
+                return out
+            except Exception:
+                return orig(self, map_key)
+        xs = np.log(np.array([s for s, _ in same], dtype=float))
+        ys = np.log(np.stack([v for _, v in same]))
+        x = float(np.log(map_key[0]))
+        out = np.exp(np.array([np.interp(x, xs, ys[:, j])
+                               for j in range(ys.shape[1])]))
+        INTERPOLATED[tuple(map_key)] = out.tolist()
+        return out
+
+    def patched(self, map_key):
+        pm = getattr(self, "profile_map", {})
+        if FAITHFUL:
+            # UA_FAITHFUL: the executor's own measured profile is the cost (UltraAttn App. B.1.2): exact entry if
+            # profiled, else log-log in S along the same ratio, else FLOP-scaled nearest entry. No replacement.
+            if map_key in pm:
+                return np.asarray(orig(self, map_key), dtype=float)
+            return _nearest_entry(self, map_key, pm)
+        lin = _linear(pm, map_key)
+        if map_key in pm:
+            v = np.asarray(orig(self, map_key), dtype=float)
+            if lin is not None and lin[0] > 0 and not (1.0 / DEV <= v[0] / lin[0] <= DEV):
+                INTERPOLATED[tuple(map_key)] = lin.tolist()     # profiled entry off the linear rate
+                return lin
+            return v
+        if lin is not None:                                      # unprofiled fused shape
+            INTERPOLATED[tuple(map_key)] = lin.tolist()
+            return lin
+        return _nearest_entry(self, map_key, pm)                  # nearest profiled entry
+
+    if os.environ.get("COST_DEBUG"):
+        _p2 = patched
+        _logf = open(os.environ["COST_DEBUG"], "a")
+        def patched(self, map_key):          # noqa: F811
+            r = _p2(self, map_key)
+            try:
+                ms = float(np.asarray(r).ravel()[0]) * 1e3
+                hit = "PROF" if map_key in getattr(self, "profile_map", {}) else "FALL"
+                _logf.write(f"{ms:10.3f}ms  {hit:8s}  {tuple(map_key)}\n"); _logf.flush()
+            except Exception:
+                pass
+            return r
+    Comp_Profile_Map.get_comp_time_from_map_key = patched
+
+    # The ratio whitelist sits in get_comp_map_key, which runs BEFORE the
+    # lookup above, so an unprofiled ratio would abort the rung before the
+    # lookup ever saw the key.  Rebuild the key without that one assert (the
+    # GQA assert is kept -- that one is a real unsupported case, not a gap in
+    # the profile data).
+    import math as _math
+    from search_algo.search_engine import FlashAttn_Profile_Map
+
+    def key_no_ratio_assert(self, da_config, batch_degrees, split_degrees,
+                            causal=False):
+        assert len(batch_degrees) == 2 and len(split_degrees) == 4
+        sq = da_config.S[0] * batch_degrees[0] // split_degrees[0]
+        skv = da_config.S[1] * batch_degrees[1] // split_degrees[1]
+        bs = da_config.bs // split_degrees[2]
+        nh = da_config.Nh[0] // split_degrees[3]
+        g = _math.gcd(sq, skv)
+        if not FAITHFUL:
+            assert da_config.Nh[0] == da_config.Nh[1], \
+                f"GQA unsupported: Nh={da_config.Nh[0]}, Ng={da_config.Nh[1]}"
+        # GQA (UA_FAITHFUL): the key keeps Nh = query heads; the profile DB is per model (measured with that
+        # model's K/V heads, tools/profile_kernel.py --nkv), so the entry already prices the GQA kernel.
+        return (min(sq, skv), bs, nh, da_config.D, f"{sq // g}/{skv // g}", causal)
+
+    for _cls in (Comp_Profile_Map, FlashAttn_Profile_Map, Machine_Config):
+        if hasattr(_cls, "get_comp_map_key"):
+            _cls.get_comp_map_key = key_no_ratio_assert
+
+
+def build_plans(prob, bsa_config, schedule_table, S_map, prof_db, args):  # noqa: C901
+    n = prob.n_blocks
+    shape_config = {
+        "S": (n * args.block_tokens, n * args.block_tokens),
+        "Nh": (args.heads, getattr(args, "kv_heads", 0) or args.heads),    # (Q heads, K/V heads)
+        "bs": 1,
+        "D": 128,
+    }
+    da_config = Dist_Attn_Config.from_bsa_config(bsa_config, shape_config, hierarchy=1)
+    split_degrees = [n, n, 1, 1]                     # Sq, Skv, bs, Nh
+    if FAITHFUL:
+        import search_algo.dependent_graph as _dg
+        w = np.asarray(prob.weights(), dtype=float)
+        nom = np.where(w == 0, 0.0, np.where(np.abs(w - 0.5) < 1e-9, 0.5, 1.0))   # what the block table prices
+        _dg.LIVE_SCALE = (w, nom)
+    _t0 = time.perf_counter()
+    schedule = Dist_Attn_Schedule(da_config, prof_db.m_config, split_degrees,
+                                  S_map, schedule_table, hierarchy=1)
+    print(f"[phase] n_blocks={n} bt={args.block_tokens} stage=schedule_table "
+          f"seconds={time.perf_counter() - _t0:.4f}", flush=True)
+    out, failed = {}, {}
+    ladder = [a for a in ABLATIONS
+              if args.sched_rungs == "all" or a[2] == "Flexflow"]
+    for gpu_tile, kernel_tile, kernel_sched in ladder:
+        # transform_mode: their own 'greedy' (largest-first, one pass over the
+        # non-conflicting transformations, ONE plan evaluated) rather than 'bf'.
+        # 'bf' enumerates every SUBSET of the candidate fusions and builds a full
+        # Execution_Plan at each leaf; on a regular star/stream pattern trans_all
+        # is tiny and that is fine, but on an irregular mask it explodes -- an
+    # 8-block longformer mask produces over 10^5 leaves, and
+    # 32 blocks exceed the recursion limit.
+        exp_config = Evaluation_Configs(plan_type=kernel_sched, MAX_QUEUE_SIZE=0,
+                                        fob=getattr(args, "fob", 0), hierarchy=1,
+                                        transform_mode=args.transform_mode)
+        _t = time.perf_counter()
+        d_graph = Dependent_Graph(schedule, exp_config.fob)
+        print(f"[phase] n_blocks={n} bt={args.block_tokens} stage=dep_graph "
+              f"rung={kernel_tile}/{kernel_sched} "
+              f"seconds={time.perf_counter() - _t:.4f}", flush=True)
+        _t = time.perf_counter()
+        try:
+            if kernel_tile == "w_kernel_tile":
+                # Graph_Transformation_Engine.dfs_trans enumerates every SUBSET of
+                # the candidate fusions and builds a full Execution_Plan (ILP and
+                # all) at each leaf.  That is fine at the Par_D=8 their own
+                # experiments use and intractable past ~16: the recursion depth is
+                # the number of candidate transformations and the leaf count is
+                # exponential in it.  Record the rung as unavailable rather than
+                # stopping the whole run.
+                gt = Graph_Transformation_Engine(exp_config, da_config, prof_db.m_config)
+                plan = gt.transform(d_graph, exp_config.transform_mode,
+                                    plan_type=kernel_sched)
+            else:
+                plan = Execution_Plan(d_graph, exp_config.fob, plan_type=kernel_sched)
+        except RecursionError as e:
+            failed[(gpu_tile, kernel_tile, kernel_sched)] = f"RecursionError ({e})"
+            print(f"[phase] n_blocks={n} bt={args.block_tokens} "
+                  f"stage={'fusion' if kernel_tile == 'w_kernel_tile' else 'schedule'} "
+                  f"rung={kernel_tile}/{kernel_sched} "
+                  f"seconds={time.perf_counter() - _t:.4f} status=RecursionError",
+                  flush=True)
+            continue
+        except Exception as e:                      # noqa: BLE001 - report, continue
+            failed[(gpu_tile, kernel_tile, kernel_sched)] = f"{type(e).__name__}: {e}"
+            print(f"[phase] n_blocks={n} bt={args.block_tokens} "
+                  f"stage={'fusion' if kernel_tile == 'w_kernel_tile' else 'schedule'} "
+                  f"rung={kernel_tile}/{kernel_sched} "
+                  f"seconds={time.perf_counter() - _t:.4f} "
+                  f"status={type(e).__name__}", flush=True)
+            continue
+        # For w_kernel_tile the scheduling is done INSIDE the transformation
+        # search (a full Execution_Plan is built at every leaf), so this one
+        # number covers fusion+schedule and is not comparable to the pure
+        # schedule timing of the rung above it.
+        print(f"[phase] n_blocks={n} bt={args.block_tokens} "
+              f"stage={'fusion' if kernel_tile == 'w_kernel_tile' else 'schedule'} "
+              f"rung={kernel_tile}/{kernel_sched} "
+              f"seconds={time.perf_counter() - _t:.4f} status=ok", flush=True)
+        out[(gpu_tile, kernel_tile, kernel_sched)] = plan
+    return da_config, schedule, out, failed
+
+
+def register_plans(plans, da_config, prof_db, fob=0):
+    """Write the plans into UltraAttn's own plan store so that its profiler
+    (`profile_all_intra_BSA`) picks them up by key, exactly as it would its own."""
+    import json as _json
+    import pickle
+    kv_path = prof_db.INTRA_BSA_EXE_PLANS_KV
+    kv = _json.load(open(kv_path)) if os.path.exists(kv_path) else {}
+    os.makedirs(prof_db.INTRA_BSA_EXE_PLANS_DIR, exist_ok=True)
+    keys = []
+    for (gpu_tile, kernel_tile, kernel_sched), plan in plans.items():
+        key = ablation_key(da_config, fob, gpu_tile, kernel_tile, kernel_sched)
+        keys.append(key)
+        if key in kv:
+            plan_id = kv[key]
+        else:
+            plan_id = (max(kv.values()) + 1) if kv else 0
+            kv[key] = plan_id
+        with open(f"{prof_db.INTRA_BSA_EXE_PLANS_DIR}/{plan_id}.pkl", "wb") as f:
+            pickle.dump(plan, f)
+    with open(kv_path, "w") as f:
+        _json.dump(kv, f)
+    return keys
+
+
+
+def measure_plans(plans, da_config, exp_config, gloo_group, ncclcomm_global,
+                  warmup=4, iters=4):
+    """Run each plan on the GPUs through UltraAttn's own benchmark harness.
+
+    `profile_all_intra_BSA` insists the plan store holds all five ablation keys
+    before it will measure anything; we call the benchmark it wraps directly, so
+    whichever rungs built can be measured.  The dummy one-node inter plan and the
+    `inter_comp_plans_dict` shape are copied from that function.
+    """
+    PROC_INFO = get_global_var("PROC_INFO")
+    node_id = PROC_INFO["nodeid"]
+    S_per_gpu = max(da_config.S_per_gpu)
+    Nh = max(da_config.shape_config["Nh"])
+    D = da_config.shape_config["D"]
+    bs = da_config.shape_config["bs"]
+    buf_elems = (bs * S_per_gpu * Nh * D * 4) * 3 + (bs * S_per_gpu * Nh * D * 3 + 9) * 4
+    tensor_buf = torch.empty(int(buf_elems), device=torch.cuda.current_device(),
+                             dtype=torch.bfloat16, requires_grad=False)
+
+    names, inter_plans, comp_dicts = [], [], []
+    for name, plan in plans.items():
+        dummy = Execution_Plan.create_one_node_exe_plan(exp_config.fob)
+        d = {((1, 1), str(da_config.bsa_config.bsa_repr)): plan}
+        dummy.gpu_kernel_lists[node_id][0].execution_plan = plan
+        names.append(name); inter_plans.append(dummy); comp_dicts.append(d)
+
+    # Their parse_args() reads sys.argv and rejects anything it does not define,
+    # so hide our flags from it and take its defaults.
+    _argv = sys.argv
+    try:
+        sys.argv = [_argv[0]]
+        ua_args = ua_parse_args()
+    finally:
+        sys.argv = _argv
+    bench = partial(benchmark_orchestrate_bsa, ua_args, orchestrated_attn_func,
+                    da_config, exp_config, tensor_buf,
+                    inter_bsa_execution_plans=inter_plans,
+                    inter_comp_plans_dicts=comp_dicts,
+                    global_group=gloo_group, ncclcomm_global=ncclcomm_global,
+                    warmup=warmup, num_iter=iters, log=True)
+    results = bench(use_cudagraph=False)
+    del tensor_buf
+    torch.cuda.empty_cache()
+    return list(zip(names, results))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--problem", required=True)
+    ap.add_argument("--strategy", default="dcp")
+    ap.add_argument("--cp", type=int, default=4)
+    ap.add_argument("--block-tokens", type=int, default=512)
+    ap.add_argument("--heads", type=int, default=8)
+    ap.add_argument("--sched-rungs", default="flexflow",
+                    choices=["flexflow", "all"],
+                    help="'all' includes the ILP-scheduled rungs. That model is "
+                         "quadratic in kernel count (one binary per pair of "
+                         "kernels sharing a stream), so on the assignments that "
+                         "emit the most kernels it does not finish -- 41 min and "
+                         "counting on shared_prefix/ultraattn -- while the "
+                         "measured ILP-vs-Flexflow effect is 1.000-1.002x.")
+    ap.add_argument("--warmup", type=int, default=4)
+    ap.add_argument("--iters", type=int, default=4)
+    ap.add_argument("--transform-mode", default="greedy",
+                    choices=["greedy", "bf", "none"],
+                    help="kernel-tiling search. greedy is linear; bf is their "
+                         "exhaustive subset search and is intractable on "
+                         "irregular masks.")
+    ap.add_argument("--assignment", default=None,
+                    help="JSON with dev/owner to use instead of running the "
+                         "planner (node sub-problems of the 2-node hierarchy)")
+    ap.add_argument("--measure", action="store_true",
+                    help="run the built plans on the GPUs through UltraAttn's own "
+                         "benchmark harness and report wall clock, not prediction")
+    ap.add_argument("--register", action="store_true",
+                    help="write the plans into UltraAttn's plan store so its own "
+                         "profiler can measure them")
+    args = ap.parse_args()
+    set_global_var("ARGS", args)
+
+    install_profile_interpolation()
+    ncclcomm_global, gloo_group = initialize_distribution()
+    prof_db = initialize_prof_db(gloo_group)
+    rank = torch.distributed.get_rank()
+
+    prob, asg, bsa_config, table, S_map = plan_from_problem(
+        args.problem, args.strategy, args.cp,
+        assignment_file=args.assignment)
+
+    # A non-deterministic planner run independently per rank would hand
+    # each one a different assignment, so the ranks would build different plans
+    # and execute mismatched collectives.  Rank 0's assignment wins and is
+    # broadcast.
+    dev_t = torch.as_tensor(np.ascontiguousarray(asg.dev), dtype=torch.int64).cuda()
+    own_t = torch.as_tensor(np.ascontiguousarray(asg.owner), dtype=torch.int64).cuda()
+    torch.distributed.broadcast(dev_t, 0)
+    torch.distributed.broadcast(own_t, 0)
+    dev_np, own_np = dev_t.cpu().numpy(), own_t.cpu().numpy()
+    from search_algo.dcp_adapter import (assignment_to_schedule_table,
+                                         build_bsa_config)
+    asg.dev, asg.owner = dev_np, own_np
+    bsa_config = build_bsa_config(prob, own_np, args.cp, 1)
+    table = assignment_to_schedule_table(prob, dev_np)
+    S_map = np.asarray(own_np, dtype=np.int32).reshape(1, prob.n_blocks)
+
+    built = {}
+    if rank == 0:
+        print(f"[{args.strategy}] {os.path.basename(args.problem)} "
+              f"N={prob.n_blocks} CP={args.cp}", flush=True)
+        da_config, schedule, plans, failed = build_plans(prob, bsa_config, table,
+                                                         S_map, prof_db, args)
+        for name, plan in plans.items():
+            tag = ",".join(x for x in name if x)
+            print(f"  {tag:44s} end_time={plan.get_end_time():.3e}", flush=True)
+        for name, why in failed.items():
+            tag = ",".join(x for x in name if x)
+            print(f"  {tag:44s} UNAVAILABLE: {why[:200]}", flush=True)
+        if INTERPOLATED:
+            print(f"  [cost model] {len(INTERPOLATED)} fused shape(s) priced by "
+                  f"interpolation, not measured: "
+                  f"{sorted(k[0] for k in INTERPOLATED)[:8]}", flush=True)
+        if args.register:
+            keys = register_plans(plans, da_config, prof_db)
+            print(f"  registered {len(keys)} ablation keys into "
+                  f"{prof_db.INTRA_BSA_EXE_PLANS_KV}", flush=True)
+        built = plans
+    torch.distributed.barrier(gloo_group)
+
+    if args.measure:
+        # Every rank must build the same plans -- the harness executes them
+        # collectively.  Rank 0 already did; the others do it now.
+        if rank != 0:
+            da_config, schedule, built, _ = build_plans(prob, bsa_config, table,
+                                                        S_map, prof_db, args)
+        else:
+            da_config, schedule, _b, _f = build_plans(prob, bsa_config, table,
+                                                      S_map, prof_db, args)
+            built = _b
+        exp_config = Evaluation_Configs(plan_type="Flexflow", MAX_QUEUE_SIZE=0,
+                                        fob=0, hierarchy=1,
+                                        transform_mode=args.transform_mode)
+        torch.distributed.barrier(gloo_group)
+        res = measure_plans(built, da_config, exp_config, gloo_group,
+                            ncclcomm_global, warmup=args.warmup, iters=args.iters)
+        if rank == 0:
+            # Persist under the SAME ablation keys register_plans writes, because
+            # UltraAttn's inter level prices a node tile by looking its intra plan
+            # up in INTRA_BSA_EXE_PLANS_PROFILE (Inter_Comp_Profile_Map reads
+            # profile_map[key]['time']).  Without this the two-level path has no
+            # cost model for the sub-problems and cannot be built at all.
+            import json as _json
+            pf = prof_db.INTRA_BSA_EXE_PLANS_PROFILE
+            prof = _json.load(open(pf)) if os.path.exists(pf) else {}
+            for name, r in res:
+                tag = ",".join(x for x in name if x)
+                key = ablation_key(da_config, 0, *name)
+                prof[key] = {"hfu": r.get("hfu"), "time": r.get("time")}
+                print(f"  MEASURED {tag:44s} {r}", flush=True)
+            with open(pf, "w") as f:
+                _json.dump(prof, f)
+            print(f"  persisted {len(res)} measurements into {os.path.basename(pf)}",
+                  flush=True)
+    torch.distributed.barrier(gloo_group)
+
+
+if __name__ == "__main__":
+    main()
