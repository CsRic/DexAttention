+"""LSE-weighted online-softmax merge for combining attention partials.
+
+Ported from long-context-attention (yunchang/ring/utils.py `_update_out_and_lse`),
+the numerically stable ring-attention merge. UltraAttn's runtime does not combine
+partials of one Q row from different KV shards (receives overwrite, reduce_scatter
+sums), which is correct only when a Q row's whole KV lives on one contributor;
+this module adds the LSE-weighted merge that combines them.
+
+Convention here (matches flash-attn's raw output):
+    O   : [b, S, H, D]  fp32 accumulator
+    lse : [b, H, S]     fp32   (natural log of the softmax denominator)
+Both `out`/`lse` and the block being merged in use this layout; `lse` is carried
+internally as [b, S, H, 1] to broadcast against O.
+"""
+import torch
+import torch.nn.functional as F
+
+
+def _to_internal_lse(lse_bhs):
+    # [b, H, S] -> [b, S, H, 1]
+    return lse_bhs.transpose(-2, -1).unsqueeze(dim=-1).contiguous()
+
+
+def _from_internal_lse(lse_bshi):
+    # [b, S, H, 1] -> [b, H, S]
+    return lse_bshi.squeeze(-1).transpose(-2, -1).contiguous()
+
+
+def merge_(out, lse_bshi, block_out, block_lse_bhs):
+    """In-place online-softmax merge of one block into (out, lse_bshi).
+
+    out         : [b, S, H, D] fp32, the running accumulator (modified in place)
+    lse_bshi    : [b, S, H, 1] fp32, the running lse (modified in place)
+    block_out   : [b, S, H, D] the block to fold in (any float dtype)
+    block_lse_bhs: [b, H, S]   its lse
+
+    Returns (out, lse_bshi). Numerically stable form (identical to
+    long-context-attention): a sigmoid/logsigmoid rewrite of the log-sum-exp
+    update that never exponentiates a positive argument.
+    """
+    block_out = block_out.to(torch.float32)
+    block_lse = _to_internal_lse(block_lse_bhs).to(torch.float32)
+    out.sub_(torch.sigmoid(block_lse - lse_bshi) * (out - block_out))
+    lse_bshi.sub_(F.logsigmoid(lse_bshi - block_lse))
+    return out, lse_bshi
+
+
+def new_accumulator(block_out, block_lse_bhs):
+    """Seed an accumulator from the first block (fp32 copies)."""
+    out = block_out.to(torch.float32).clone()
+    lse = _to_internal_lse(block_lse_bhs).to(torch.float32).clone()
+    return out, lse
