+def _rescale_partials_by_lse(or_buf, lse, r_ncclcomm, X, Q_shape_row, stream):
+    """In place: scale each of the X partials in `or_buf` by exp(lse_i - LSE),
+    where LSE = logsumexp over the X 'r'-group members of their lse. `lse` is this
+    member's [1, Nh, X*Sq] (flash-attn layout); `or_buf` views as Q_shape_row =
+    [1, X*Sq, Nh, D]. After this, a plain SUM reduce_scatter is the exact merge."""
+    import torch as _t
+    with _t.cuda.stream(stream):
+        own = lse.contiguous()                       # [1, Nh, X*Sq] fp32
+        gathered = _t.empty(X * own.numel(), device=own.device, dtype=own.dtype)
+        r_ncclcomm.all_gather(own.reshape(-1), gathered, stream)
+        G = gathered.view(X, *own.shape)             # [X, 1, Nh, X*Sq]
+        m = G.amax(0)                                # [1, Nh, X*Sq]
+        LSE = m + _t.log(_t.exp(G - m).sum(0))       # [1, Nh, X*Sq]
+        w = _t.exp(own - LSE)                        # [1, Nh, X*Sq]
+        o = or_buf.view(Q_shape_row)                 # [1, X*Sq, Nh, D]
+        o.mul_(w.transpose(1, 2).unsqueeze(-1).to(o.dtype))
+
