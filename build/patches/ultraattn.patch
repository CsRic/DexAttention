+# --- compatibility shim -------------------------------------------------------
+# UltraAttn was written against flash-attn 2.5.x (its `v2.5.7_burst` fork).  In
+# 2.7+ `_flash_attn_forward` lost the `out=` argument, split `window_size` into
+# two ints, gained `softcap`, and returns 4 values instead of 8.  These wrappers
+# keep the call sites below unchanged.
+def _fa_fwd(q, k, v, dropout_p, softmax_scale, causal=False, window_size=(-1, -1),
+            alibi_slopes=None, return_softmax=False, out=None):
+    o, lse, S_dmask, rng_state = _flash_attn_forward(
+        q, k, v, dropout_p, softmax_scale, causal,
+        window_size[0], window_size[1], 0.0, alibi_slopes, return_softmax)
+    if out is not None:
+        out.copy_(o)
+        o = out
+    return o, q, k, v, o, lse, S_dmask, rng_state
+
+
+def _fa_bwd(dout, q, k, v, o, lse, dq, dk, dv, dropout_p, softmax_scale, causal,
